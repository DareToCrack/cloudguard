# Copy this file to backend/.env and adjust values as needed.
# All variables are prefixed with CLOUDGUARD_ and map to backend/app/core/config.py

# -- Application --------------------------------------------------------
CLOUDGUARD_APP_NAME=CloudGuard
CLOUDGUARD_ENVIRONMENT=development
CLOUDGUARD_DEBUG=true
# Generate a real secret for anything beyond local development:
#   python -c "import secrets; print(secrets.token_hex(32))"
CLOUDGUARD_SECRET_KEY=change-me-in-production-use-a-random-64-char-string
CLOUDGUARD_API_HOST=0.0.0.0
CLOUDGUARD_API_PORT=8000

# -- Database -------------------------------------------------------------
# SQLite is the default and requires no setup. For production, point this
# at PostgreSQL, e.g.:
#   CLOUDGUARD_DATABASE_URL=postgresql://user:password@localhost:5432/cloudguard
CLOUDGUARD_DATABASE_URL=sqlite:///./cloudguard.db

# -- AWS ------------------------------------------------------------------
# Leave AWS_PROFILE unset to use the default credential chain (env vars,
# instance profile, SSO, etc). If no credentials are found at all,
# CloudGuard automatically falls back to demo mode with synthetic data.
CLOUDGUARD_AWS_PROFILE=
CLOUDGUARD_AWS_DEFAULT_REGION=us-east-1

# -- Azure ----------------------------------------------------------------
# Leave AZURE_SUBSCRIPTION_ID unset to scan the first visible
# subscription (after `az login` or with service-principal env vars:
# AZURE_TENANT_ID, AZURE_CLIENT_ID, AZURE_CLIENT_SECRET). If no
# credentials are found at all, CloudGuard automatically falls back to
# demo mode with synthetic Azure data.
CLOUDGUARD_AZURE_SUBSCRIPTION_ID=

# -- Scanning ---------------------------------------------------------------
CLOUDGUARD_SCAN_REGIONS=us-east-1,us-west-2
CLOUDGUARD_FINDINGS_RETENTION_DAYS=365

# -- CORS -------------------------------------------------------------------
CLOUDGUARD_CORS_ORIGINS=http://localhost:3000,http://localhost:8000
